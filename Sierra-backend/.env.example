# Copy this file to .env and fill what you have. Lines you do not need can stay commented or be deleted.

# --- Server ---
PORT=5001

# --- Sierra login/signup (REQUIRED for auth, at least 16 characters) ---
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIERRA_AUTH_SECRET=

# --- MongoDB (needed to VERIFY Express projects; leave commented to run without it) ---
# local:  mongodb://localhost:27017/sierra
# atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/sierra
# MONGODB_URI=

# --- AI (optional). Order tried: Gemini -> Groq -> Anthropic. No key = default entity schema. ---
# GEMINI_API_KEY=
# SIERRA_LLM_MODEL=gemini-2.5-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_API_KEY=

# --- Optional ---
# SIERRA_MAX_FIX_ATTEMPTS=3
# REDIS_URL=redis://localhost:6379
